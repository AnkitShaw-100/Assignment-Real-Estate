# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/niwas?retryWrites=true&w=majority

# Optional: DNS resolvers for the mongodb+srv lookup, comma separated.
# Set this if startup fails with "querySrv ECONNREFUSED".
DNS_SERVERS=

# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# Emails that become admin on first sign-in, comma separated
ADMIN_EMAILS=you@example.com

# Development only: act as any user via the x-dev-user header when Clerk keys are absent.
# Refused when NODE_ENV=production.
DEV_AUTH=false

# Clerk → API keys
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Cloudinary → Dashboard (optional; uploads are disabled without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
