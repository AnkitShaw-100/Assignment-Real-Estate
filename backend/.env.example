# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/niwas?retryWrites=true&w=majority

# Optional: DNS resolvers for the mongodb+srv lookup, comma separated.
# Set this if startup fails with "querySrv ECONNREFUSED".
DNS_SERVERS=

# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# Emails that become admin when they register, comma separated.
# Everyone else signs up as a normal user; admins can change roles in the CRM.
ADMIN_EMAILS=you@example.com

# Signs session tokens (required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Password for demo staff accounts created by `npm run seed`.
# Leave empty to generate a random one (printed in the terminal).
SEED_PASSWORD=

# Cloudinary → Dashboard (optional; uploads are disabled without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
