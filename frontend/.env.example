# Copy to .env.local

# Clerk → API keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Deployed API origin (leave empty in dev: /api is proxied to localhost:5000)
VITE_API_URL=

# Development only, when Clerk keys are not set: sign in as a seeded user.
# Run the backend with `npm run dev:memory` (DEV_AUTH is on there). Ignored in production builds.
# VITE_DEV_USER=admin+clerk_test@niwas.app
